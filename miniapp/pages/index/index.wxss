.page {
  padding-bottom: 40rpx;
  min-height: 100vh;
}

/* 轮播 */
.banner {
  height: 360rpx;
}

.banner-item {
  height: 360rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
}

.banner-deco {
  position: absolute;
  right: -60rpx;
  top: -40rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.banner-deco::after {
  content: '';
  position: absolute;
  right: 40rpx;
  bottom: 40rpx;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.banner-content {
  position: relative;
  z-index: 1;
  padding: 48rpx 40rpx;
}

.banner-tag {
  display: inline-block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  background: rgba(255, 255, 255, 0.15);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
  margin-bottom: 16rpx;
}

.banner-title {
  font-size: 44rpx;
  color: #fff;
  font-weight: 700;
  display: block;
  letter-spacing: 2rpx;
}

.banner-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  margin-top: 12rpx;
  display: block;
  line-height: 1.5;
}

/* 简介 */
.intro {
  margin-top: 24rpx;
}

.intro-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.intro-icon {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #eef5ec, #d4e8cf);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.intro-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.intro-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
  display: block;
}

.intro-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.intro-tags .tag {
  font-size: 22rpx;
  color: var(--color-primary);
  background: #eef5ec;
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full);
}

/* 功能网格 — 使用百分比宽度，兼容真机 */
.menu-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.menu-item {
  width: 48%;
  flex: 0 0 48%;
  box-sizing: border-box;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 32rpx 16rpx;
  margin-bottom: 20rpx;
  text-align: center;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--color-border);
}

.menu-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16rpx;
}

.icon-green { background: linear-gradient(135deg, #e8f5e6, #c8e6c3); }
.icon-teal { background: linear-gradient(135deg, #e0f2f1, #b2dfdb); }
.icon-gold { background: linear-gradient(135deg, #fff8e1, #ffe082); }
.icon-brown { background: linear-gradient(135deg, #efebe9, #d7ccc8); }

.menu-icon {
  font-size: 40rpx;
}

.menu-label {
  font-size: 30rpx;
  color: var(--color-text);
  font-weight: 600;
  display: block;
}

.menu-desc {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 6rpx;
  display: block;
}
