.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
  overflow-x: hidden;
}

/* ============================================================
   Hero — 沉浸式
   ============================================================ */

.hero {
  position: relative;
  padding: 28rpx 36rpx 44rpx;
  overflow: hidden;
  min-height: 320rpx;
  display: flex;
  align-items: flex-start;
}

.hero-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at 20% 80%, rgba(74, 140, 63, 0.4) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 20%, rgba(196, 165, 116, 0.3) 0%, transparent 50%),
    linear-gradient(160deg, #0a1f0a 0%, #1a3d16 40%, #2d5a27 100%);
  border-radius: 0 0 64rpx 64rpx;
}

.hero-noise {
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 2rpx,
    rgba(255, 255, 255, 0.015) 2rpx,
    rgba(255, 255, 255, 0.015) 4rpx
  );
}

/* 装饰环 */
.hero-deco-ring {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.06);
}

.r1 {
  width: 400rpx;
  height: 400rpx;
  right: -100rpx;
  top: -100rpx;
}

.r2 {
  width: 240rpx;
  height: 240rpx;
  right: 40rpx;
  top: 80rpx;
}

.hero-inner {
  position: relative;
  z-index: 2;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.badge-dot {
  width: 12rpx;
  height: 12rpx;
  background: #34c759;
  border-radius: 50%;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(52, 199, 89, 0.4); }
  50% { opacity: 0.8; box-shadow: 0 0 0 12rpx rgba(52, 199, 89, 0); }
}

.hero-headline {
  display: block;
  font-size: 52rpx;
  font-weight: 900;
  color: #fff;
  line-height: 1.2;
  letter-spacing: 3rpx;
  margin-bottom: 16rpx;
}

.hero-sub {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 2rpx;
  margin-bottom: 28rpx;
}

.hero-cta {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: var(--radius-full);
  padding: 20rpx 36rpx;
  transition: transform 0.2s var(--ease-bounce), background 0.2s;
}

.hero-cta:active {
  transform: scale(0.96);
  background: rgba(255, 255, 255, 0.2);
}

.cta-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}

.cta-arrow {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  transition: transform 0.2s;
}

.hero-cta:active .cta-arrow {
  transform: translateX(6rpx);
}

/* ============================================================
   Section 通用
   ============================================================ */

.section {
  padding: 0 24rpx;
  margin-top: 40rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.section-label {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  letter-spacing: 1rpx;
}

.section-more {
  font-size: 24rpx;
  color: var(--color-text-muted);
  transition: color 0.15s;
}

.section-more:active {
  color: var(--color-primary);
}

/* ============================================================
   今日茶识 — 横向卡片
   ============================================================ */

.fact-scroll {
  margin: 0 -24rpx;
  white-space: nowrap;
}

.fact-list {
  display: inline-flex;
  padding: 0 24rpx 16rpx;
  gap: 16rpx;
}

.fact-card {
  width: 320rpx;
  height: 220rpx;
  border-radius: var(--radius-xl);
  overflow: hidden;
  position: relative;
  display: inline-flex;
  flex-shrink: 0;
  transition: transform 0.2s var(--ease-bounce);
}

.fact-card:active {
  transform: scale(0.97);
}

.fact-bg {
  position: absolute;
  inset: 0;
}

.fact-content {
  position: relative;
  z-index: 2;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  height: 100%;
  box-sizing: border-box;
}

.fact-tag {
  display: inline-block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.15);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  margin-bottom: 12rpx;
  align-self: flex-start;
}

.fact-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.fact-text {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  line-height: 1.5;
  white-space: normal;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ============================================================
   常用工具 — 网格布局
   ============================================================ */

.tool-grid {
  display: flex;
  flex-wrap: wrap;
  row-gap: 32rpx;
  padding: 8rpx 12rpx 16rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-xs);
  border: 1rpx solid var(--color-border);
}

.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  width: 25%;
  box-sizing: border-box;
  flex-shrink: 0;
  transition: transform 0.2s var(--ease-bounce);
}

.tool-item:active {
  transform: scale(0.9);
}

.tool-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

/* 背景色 */
.bg1 { background: linear-gradient(145deg, #e8f5e6, #c8e6c3); }
.bg2 { background: linear-gradient(145deg, #fce4ec, #f8bbd0); }
.bg3 { background: linear-gradient(145deg, #fff8e1, #ffe082); }
.bg4 { background: linear-gradient(145deg, #e3f2fd, #bbdefb); }
.bg5 { background: linear-gradient(145deg, #f3e5f5, #e1bee7); }
.bg6 { background: linear-gradient(145deg, #e0f7fa, #b2ebf2); }
.bg7 { background: linear-gradient(145deg, #fff3e0, #ffe0b2); }
.bg8 { background: linear-gradient(145deg, #efebe9, #d7ccc8); }

/* CSS 图标 */
.tool-ring {
  width: 36rpx;
  height: 36rpx;
  border: 4rpx solid #4a8c3f;
  border-radius: 50%;
}

.tool-hand {
  position: absolute;
  top: 38rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 4rpx;
  height: 14rpx;
  background: #4a8c3f;
  border-radius: 2rpx;
  transform-origin: top center;
  animation: clockTick 4s linear infinite;
}

@keyframes clockTick {
  0% { transform: translateX(-50%) rotate(0deg); }
  100% { transform: translateX(-50%) rotate(360deg); }
}

.tool-book {
  width: 28rpx;
  height: 22rpx;
  border: 3rpx solid #c2185b;
  border-radius: 0 6rpx 6rpx 0;
  position: relative;
}

.tool-book::before {
  content: '';
  position: absolute;
  left: -10rpx;
  top: 0;
  width: 10rpx;
  height: 100%;
  background: #c2185b;
  border-radius: 4rpx 0 0 4rpx;
}

.tool-book.open {
  border-color: #e65100;
  width: 32rpx;
  height: 24rpx;
}

.tool-book.open::before {
  background: #e65100;
}

.tool-star {
  width: 28rpx;
  height: 28rpx;
  position: relative;
}

.tool-star::before {
  content: '★';
  font-size: 36rpx;
  color: #f9a825;
  position: absolute;
  top: -4rpx;
  left: 0;
}

.tool-lens {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #1565c0;
  border-radius: 50%;
  position: relative;
}

.tool-lens::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  right: -10rpx;
  width: 4rpx;
  height: 14rpx;
  background: #1565c0;
  border-radius: 2rpx;
  transform: rotate(-45deg);
}

.tool-bullseye {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #7b1fa2;
  border-radius: 50%;
  position: relative;
}

.tool-bullseye::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid #7b1fa2;
  border-radius: 50%;
}

.tool-bullseye::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 6rpx;
  height: 6rpx;
  background: #7b1fa2;
  border-radius: 50%;
}

.tool-steps {
  display: flex;
  gap: 6rpx;
  align-items: center;
}

.step-dot {
  width: 10rpx;
  height: 10rpx;
  background: #00838f;
  border-radius: 50%;
}

.step-dot:nth-child(2) {
  width: 8rpx;
  height: 8rpx;
  opacity: 0.6;
}

.step-dot:nth-child(3) {
  width: 6rpx;
  height: 6rpx;
  opacity: 0.3;
}

.tool-clock {
  width: 30rpx;
  height: 30rpx;
  border: 3rpx solid #6d4c41;
  border-radius: 50%;
  position: relative;
}

.tool-clock::before {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 12rpx;
  width: 3rpx;
  height: 10rpx;
  background: #6d4c41;
  border-radius: 2rpx;
  transform-origin: bottom center;
}

.tool-clock::after {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 12rpx;
  width: 8rpx;
  height: 3rpx;
  background: #6d4c41;
  border-radius: 2rpx;
}

.tool-name {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
  white-space: nowrap;
}

/* ============================================================
   快速提问
   ============================================================ */

.ask-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ask-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  box-shadow: var(--shadow-xs);
  border: 1rpx solid var(--color-border);
  transition: transform 0.2s var(--ease-bounce), background 0.15s;
}

.ask-card:active {
  transform: scale(0.98);
  background: var(--color-bg-warm);
}

.ask-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #e8f5e6, #c8e6c3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-primary);
  flex-shrink: 0;
}

.ask-body {
  flex: 1;
  min-width: 0;
}

.ask-q {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
  margin-bottom: 4rpx;
}

.ask-hint {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.ask-go {
  font-size: 32rpx;
  color: var(--color-text-muted);
  flex-shrink: 0;
  transition: transform 0.2s, color 0.2s;
}

.ask-card:active .ask-go {
  transform: translateX(6rpx);
  color: var(--color-primary);
}

/* ============================================================
   季节推荐
   ============================================================ */

.season-card {
  border-radius: var(--radius-xl);
  overflow: hidden;
  position: relative;
  min-height: 240rpx;
}

.season-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse at 100% 0%, rgba(196, 165, 116, 0.3) 0%, transparent 60%),
    linear-gradient(145deg, #f5f0e6, #e8dfd0);
}

.season-content {
  position: relative;
  z-index: 2;
  padding: 32rpx;
}

.season-tag {
  display: inline-block;
  font-size: 24rpx;
  color: var(--color-primary);
  background: rgba(45, 90, 39, 0.08);
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.season-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.season-text {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.season-tea {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: var(--color-card);
  padding: 10rpx 20rpx;
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-xs);
}

.season-tea-label {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.season-tea-name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
}

/* ============================================================
   茶语
   ============================================================ */

.quote-section {
  padding: 40rpx 24rpx 0;
}

.quote-card {
  text-align: center;
  padding: 40rpx 32rpx;
  background: var(--color-card);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-xs);
  border: 1rpx solid var(--color-border);
  position: relative;
}

.quote-mark {
  display: block;
  font-size: 80rpx;
  color: var(--color-accent);
  opacity: 0.2;
  line-height: 0.6;
  margin-bottom: 12rpx;
  font-family: Georgia, serif;
}

.quote-text {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.8;
  font-style: italic;
  margin-bottom: 16rpx;
}

.quote-author {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

/* ============================================================
   底部
   ============================================================ */

.footer {
  padding: 48rpx 28rpx 24rpx;
  text-align: center;
}

.footer-text {
  font-size: 22rpx;
  color: var(--color-text-muted);
  opacity: 0.4;
  letter-spacing: 2rpx;
}
