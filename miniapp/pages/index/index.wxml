<view class="page">
  <!-- 轮播横幅 -->
  <swiper class="banner" indicator-dots indicator-color="rgba(255,255,255,0.4)" indicator-active-color="#fff" autoplay circular interval="4500" duration="600">
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view class="banner-item" style="background: {{item.bg}}">
        <view class="banner-deco"></view>
        <view class="banner-content">
          <text class="banner-tag">{{item.tag}}</text>
          <text class="banner-title">{{item.title}}</text>
          <text class="banner-desc">{{item.desc}}</text>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 简介卡片 -->
  <view class="intro card">
    <view class="intro-header">
      <view class="intro-icon">🍃</view>
      <text class="intro-title">六堡茶简介</text>
    </view>
    <text class="intro-text">六堡茶产于广西梧州，是中国黑茶代表，以「红、浓、陈、醇」及独特槟榔香著称，拥有1500余年历史。</text>
    <view class="intro-tags">
      <text class="tag">黑茶</text>
      <text class="tag">梧州</text>
      <text class="tag">非遗文化</text>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="section-title">核心功能</view>
  <view class="menu-grid">
    <view class="menu-item" bindtap="goIdentify">
      <view class="menu-icon-wrap icon-green">
        <text class="menu-icon">📷</text>
      </view>
      <text class="menu-label">AI识别</text>
      <text class="menu-desc">品种·等级·病害</text>
    </view>
    <view class="menu-item" bindtap="goChat">
      <view class="menu-icon-wrap icon-teal">
        <text class="menu-icon">💬</text>
      </view>
      <text class="menu-label">智能问答</text>
      <text class="menu-desc">知识库增强</text>
    </view>
    <view class="menu-item" bindtap="goKnowledge">
      <view class="menu-icon-wrap icon-gold">
        <text class="menu-icon">📚</text>
      </view>
      <text class="menu-label">知识库</text>
      <text class="menu-desc">茶文化百科</text>
    </view>
    <view class="menu-item" bindtap="goHistory">
      <view class="menu-icon-wrap icon-brown">
        <text class="menu-icon">📋</text>
      </view>
      <text class="menu-label">历史记录</text>
      <text class="menu-desc">识别与问答</text>
    </view>
  </view>
</view>
