.tabs { display: flex; margin: 20rpx; background: #fff; border-radius: 12rpx; }
.tab { flex: 1; text-align: center; padding: 20rpx; color: #666; }
.tab.active { color: #2d5a27; font-weight: 600; border-bottom: 4rpx solid #2d5a27; }

.record { display: flex; gap: 20rpx; }
.thumb { width: 120rpx; height: 120rpx; border-radius: 8rpx; flex-shrink: 0; }
.info { flex: 1; }
.r-title { font-size: 28rpx; color: #2d5a27; font-weight: 600; display: block; }
.r-time { font-size: 22rpx; color: #999; margin: 8rpx 0; display: block; }
.r-desc { font-size: 24rpx; color: #666; display: block; }
.q { font-size: 28rpx; color: #333; display: block; margin-bottom: 12rpx; }
.a { font-size: 26rpx; color: #666; line-height: 1.6; display: block; }
.empty { text-align: center; color: #999; padding: 80rpx; }
