/* 识别统计页面 */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 48rpx;
}

/* 加载 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  gap: 16rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 5rpx solid #e0e0e0;
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

.loading-text {
  font-size: 26rpx;
  color: var(--color-text-muted);
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.empty-desc {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-muted);
  margin-bottom: 40rpx;
}

.empty-btn {
  width: 280rpx;
  height: 80rpx;
  line-height: 80rpx;
}

/* 概览卡片 */
.overview-card {
  margin: 24rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 50%, var(--color-primary-light) 100%);
  padding: 48rpx 36rpx 40rpx;
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-md);
}

.overview-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.overview-pattern {
  position: absolute;
  right: -20rpx;
  top: -20rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  opacity: 0.1;
  font-size: 80rpx;
}

.overview-content {
  position: relative;
  z-index: 1;
  text-align: center;
}

.overview-total {
  display: block;
  font-size: 88rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1;
}

.overview-label {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.overview-pills {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: 24rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.15);
}

.pill-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.pill.normal .pill-dot { background: #4caf50; }
.pill.warning .pill-dot { background: #ff9800; }

/* 图表卡片 */
.chart-card {
  margin: 24rpx;
}

.chart-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-primary);
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 圆环图 */
.pie-wrap {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.donut-ring {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: conic-gradient(
    #4caf50 0deg,
    #4caf50 calc(var(--pct) * 3.6deg),
    #ff9800 calc(var(--pct) * 3.6deg),
    #ff9800 360deg
  );
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}

.donut-ring::after {
  content: '';
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #fff;
  position: absolute;
}

.donut-center {
  position: absolute;
  text-align: center;
  z-index: 1;
}

.donut-pct {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-primary);
  line-height: 1.1;
}

.donut-label {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-muted);
  margin-top: 2rpx;
}

.pie-legend {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.legend-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.legend-dot.normal { background: #4caf50; }
.legend-dot.warning { background: #ff9800; }

.legend-key {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
}

.legend-val {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text);
}

/* 柱状图 */
.bar-chart {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.bar-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.bar-label {
  width: 60rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
  flex-shrink: 0;
  text-align: right;
}

.bar-track {
  flex: 1;
  height: 28rpx;
  background: #f0f0f0;
  border-radius: var(--radius-full);
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-primary-light), var(--color-primary));
  border-radius: var(--radius-full);
  min-width: 8rpx;
  transition: width 0.6s ease;
}

.bar-val {
  width: 40rpx;
  font-size: 24rpx;
  color: var(--color-text);
  font-weight: 600;
  text-align: right;
  flex-shrink: 0;
}

/* 任务类型 */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.task-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.task-name {
  width: 100rpx;
  font-size: 26rpx;
  color: var(--color-text);
  flex-shrink: 0;
}

.task-bar-wrap {
  flex: 1;
  height: 24rpx;
  background: #f0f0f0;
  border-radius: var(--radius-full);
  overflow: hidden;
}

.task-bar {
  height: 100%;
  background: linear-gradient(90deg, #a5d6a7, var(--color-primary));
  border-radius: var(--radius-full);
  min-width: 8rpx;
}

.task-count {
  width: 40rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
  text-align: right;
  flex-shrink: 0;
}
