<view class="page">
  <!-- 加载状态 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载统计数据...</text>
  </view>

  <!-- 无数据状态 -->
  <view class="empty-state" wx:if="{{!loading && stats.total === 0}}">
    <text class="empty-icon">📊</text>
    <text class="empty-title">暂无识别记录</text>
    <text class="empty-desc">先去拍照识别茶叶，获取您的专属数据</text>
    <button class="btn-primary empty-btn" bindtap="goIdentify">去识别</button>
  </view>

  <!-- 统计数据 -->
  <block wx:if="{{!loading && stats.total > 0}}">
    <!-- 概览卡片 -->
    <view class="overview-card">
      <view class="overview-bg">
        <view class="overview-pattern">
          <text>🍃</text><text>🍵</text><text>🍃</text>
        </view>
      </view>
      <view class="overview-content">
        <text class="overview-total">{{stats.total}}</text>
        <text class="overview-label">累计识别次数</text>
        <view class="overview-pills">
          <view class="pill normal">
            <text class="pill-dot"></text>
            <text>正常 {{stats.normal_count}}</text>
          </view>
          <view class="pill warning">
            <text class="pill-dot"></text>
            <text>异常 {{stats.abnormal_count}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 饼图：正常/异常 -->
    <view class="chart-card card">
      <text class="chart-title">正常/异常占比</text>
      <view class="pie-wrap">
        <!-- 圆环图 -->
        <view class="donut-ring">
          <view
            class="donut-segment normal"
            style="--pct: {{pieNormalPct}}"
          ></view>
          <view class="donut-center">
            <text class="donut-pct">{{pieNormalPct}}%</text>
            <text class="donut-label">正常率</text>
          </view>
        </view>
        <!-- 图例 -->
        <view class="pie-legend">
          <view class="legend-row">
            <view class="legend-dot normal"></view>
            <text class="legend-key">正常茶叶</text>
            <text class="legend-val">{{stats.normal_count}}</text>
          </view>
          <view class="legend-row">
            <view class="legend-dot warning"></view>
            <text class="legend-key">异常茶叶</text>
            <text class="legend-val">{{stats.abnormal_count}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 柱状图：月度趋势 -->
    <view class="chart-card card" wx:if="{{stats.monthly.length > 0}}">
      <text class="chart-title">近6月识别趋势</text>
      <view class="bar-chart">
        <view class="bar-row" wx:for="{{stats.monthly}}" wx:key="raw">
          <text class="bar-label">{{item.month}}</text>
          <view class="bar-track">
            <view
              class="bar-fill"
              style="width: {{item.count > 0 ? (item.count / barMaxCount * 100) : 0}}%"
            ></view>
          </view>
          <text class="bar-val">{{item.count}}</text>
        </view>
      </view>
    </view>

    <!-- 任务类型分布 -->
    <view class="chart-card card" wx:if="{{stats.by_task.length > 0}}">
      <text class="chart-title">识别任务分布</text>
      <view class="task-list">
        <view class="task-row" wx:for="{{stats.by_task}}" wx:key="task">
          <text class="task-name">{{item.task}}</text>
          <view class="task-bar-wrap">
            <view
              class="task-bar"
              style="width: {{item.count / stats.total * 100}}%"
            ></view>
          </view>
          <text class="task-count">{{item.count}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
