.page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 标题 */
.brew-header {
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 50%, var(--color-primary-light) 100%);
  padding: 48rpx 32rpx 40rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.brew-header::before {
  content: '☕';
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 80rpx;
  opacity: 0.1;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.header-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.75);
  margin-top: 8rpx;
}

/* 茶类选择 */
.tea-scroll {
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}

.tea-list {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0;
}

.tea-card {
  flex-shrink: 0;
  width: 140rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 24rpx 0;
  text-align: center;
  box-shadow: var(--shadow-sm);
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.tea-card:active {
  transform: scale(0.95);
}

.tea-card.active {
  border-color: var(--color-primary);
  background: #eef5ec;
  box-shadow: 0 4rpx 16rpx rgba(45,90,39,0.2);
}

.tea-icon {
  font-size: 44rpx;
  display: block;
  margin-bottom: 8rpx;
}

.tea-name {
  font-size: 24rpx;
  color: var(--color-text);
  font-weight: 500;
}

/* 冲泡参数 */
.params {
  margin: 0 24rpx 24rpx;
}

.param-row {
  display: flex;
  align-items: center;
}

.param-item {
  flex: 1;
  text-align: center;
}

.param-icon {
  font-size: 32rpx;
  display: block;
  margin-bottom: 4rpx;
}

.param-label {
  font-size: 22rpx;
  color: var(--color-text-muted);
  display: block;
}

.param-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-primary);
  display: block;
  margin-top: 4rpx;
}

.param-divider {
  width: 1rpx;
  height: 60rpx;
  background: #eee;
}

.param-tip {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

/* 计时器 */
.timer-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 24rpx;
}

.timer-circle {
  width: 320rpx;
  height: 320rpx;
  position: relative;
  border-radius: 50%;
  margin-bottom: 32rpx;
}

.progress-canvas {
  position: absolute;
  inset: 0;
  width: 320rpx;
  height: 320rpx;
}

.circle-inner {
  position: absolute;
  inset: 24rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 4rpx 12rpx rgba(0,0,0,0.06);
}

.timer-num {
  font-size: 80rpx;
  font-weight: 800;
  color: var(--color-primary);
  line-height: 1;
}

.timer-label {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

.timer-start-text {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
}

/* 泡数 */
.steep-info {
  text-align: center;
  margin-bottom: 32rpx;
}

.steep-label {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

.steep-next {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

/* 控制按钮 */
.controls {
  display: flex;
  gap: 24rpx;
  width: 100%;
  justify-content: center;
}

.ctrl-btn {
  padding: 24rpx 64rpx;
  border-radius: var(--radius-full);
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  transition: transform 0.15s;
}

.ctrl-btn:active {
  transform: scale(0.95);
}

.ctrl-btn.primary {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(45,90,39,0.25);
}

.ctrl-btn.secondary {
  background: var(--color-card);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.ctrl-btn.danger {
  background: var(--color-card);
  color: #e74c3c;
  border: 2rpx solid #e74c3c;
}

/* 重新开始 */
.restart {
  margin-top: 32rpx;
  font-size: 26rpx;
  color: var(--color-text-muted);
  padding: 12rpx 32rpx;
}

/* 空状态 */
.empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  gap: 16rpx;
}

.hint-icon {
  font-size: 64rpx;
  opacity: 0.4;
}

.hint-text {
  font-size: 28rpx;
  color: var(--color-text-muted);
}
