.page { min-height: 100vh; padding-bottom: 40rpx; }

.form { margin: 24rpx; }
.form-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 28rpx; }
.form-icon { font-size: 36rpx; }
.form-title { font-size: 32rpx; font-weight: 600; color: var(--color-text); }

.field { margin-bottom: 28rpx; }
.label { display: block; font-size: 26rpx; color: var(--color-text-secondary); margin-bottom: 12rpx; font-weight: 500; }
.input { height: 80rpx; background: var(--color-bg); border-radius: var(--radius-md); padding: 0 20rpx; font-size: 28rpx; }
.textarea { width: 100%; min-height: 120rpx; background: var(--color-bg); border-radius: var(--radius-md); padding: 16rpx 20rpx; font-size: 28rpx; box-sizing: border-box; }

.tag-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag { font-size: 26rpx; padding: 12rpx 24rpx; background: var(--color-bg); border-radius: var(--radius-full); color: var(--color-text-secondary); border: 2rpx solid transparent; transition: all 0.15s; }
.tag.active { background: #eef5ec; color: var(--color-primary); border-color: var(--color-primary); }

.submit-btn { margin-top: 16rpx; }

/* 结果 */
.result { padding: 0 24rpx; }
.result-header { display: flex; align-items: center; gap: 32rpx; margin-top: 24rpx; }
.score-circle { width: 160rpx; height: 160rpx; border-radius: 50%; background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary)); display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; animation: scaleIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }

@keyframes scaleIn { from { transform: scale(0); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.score-num { font-size: 52rpx; font-weight: 800; color: #fff; line-height: 1; }
.score-label { font-size: 22rpx; color: rgba(255,255,255,0.8); margin-top: 4rpx; }

.score-info { flex: 1; }
.score-level { display: block; font-size: 36rpx; font-weight: 700; color: var(--color-primary); margin-bottom: 12rpx; }
.price-range { }
.price-label { font-size: 24rpx; color: var(--color-text-muted); margin-right: 8rpx; }
.price-value { font-size: 32rpx; font-weight: 600; color: var(--color-accent); }

.detail-card { margin-top: 16rpx; animation: fadeUp 0.4s ease backwards; animation-delay: 0.2s; }
.detail-label { display: block; font-size: 26rpx; font-weight: 600; color: var(--color-primary); margin-bottom: 12rpx; }
.detail-text { font-size: 28rpx; color: var(--color-text-secondary); line-height: 1.7; }

.reset-btn { margin: 32rpx 0; }
