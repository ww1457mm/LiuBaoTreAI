/* 地图页面 */

.page {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 48rpx;
}

/* 顶部标题区 */
.map-header {
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 50%, var(--color-primary-light) 100%);
  padding: 48rpx 32rpx 120rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

.header-content {
  flex: 1;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}

.header-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 8rpx;
}

.header-decoration {
  font-size: 64rpx;
  opacity: 0.15;
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
}

/* ==================== 搜索栏 ==================== */

.search-bar {
  margin: -48rpx 24rpx 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  position: relative;
  z-index: 20;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: var(--radius-full);
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.search-placeholder {
  color: var(--color-text-muted);
}

.search-clear {
  font-size: 28rpx;
  color: var(--color-text-muted);
  padding: 8rpx 0 8rpx 12rpx;
  flex-shrink: 0;
}

.search-btn {
  background: var(--color-primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 500;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: var(--radius-full);
  box-shadow: 0 4rpx 12rpx rgba(45, 90, 39, 0.3);
  white-space: nowrap;
}

/* 搜索联想结果 */
.search-suggestions {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 200rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  z-index: 30;
  max-height: 480rpx;
  overflow-y: auto;
}

.suggestion-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.suggestion-item:last-child {
  border-bottom: none;
}

.suggestion-title {
  display: block;
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
}

.suggestion-address {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

/* ==================== 地图区域 ==================== */

.map-wrap {
  margin: 16rpx 24rpx 0;
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-lg);
  position: relative;
  border: 4rpx solid #fff;
}

.map {
  width: 100%;
  height: 500rpx;
}

.map-loading {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: var(--color-text-muted);
  font-size: 26rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 地图控制按钮组 */
.map-controls {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  z-index: 10;
}

.map-ctrl-btn {
  background: rgba(255, 255, 255, 0.95);
  border-radius: var(--radius-md);
  padding: 12rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.map-ctrl-hover {
  background: rgba(230, 230, 230, 0.95);
  transform: scale(0.95);
}

.ctrl-icon {
  font-size: 28rpx;
}

.ctrl-text {
  font-size: 18rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

/* ==================== 路线信息面板 ==================== */

.route-panel {
  margin: 16rpx 24rpx 0;
  background: #fff;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  overflow: hidden;
}

.route-header {
  padding: 24rpx;
  background: linear-gradient(135deg, var(--color-primary-dark), var(--color-primary));
}

.route-summary {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.route-duration {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.route-distance {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.route-modes {
  display: flex;
  gap: 12rpx;
}

.mode-btn {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-full);
  padding: 12rpx 0;
  font-weight: 500;
}

.mode-active {
  background: rgba(255, 255, 255, 0.35);
  color: #fff;
}

.route-steps {
  max-height: 360rpx;
  padding: 16rpx 24rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.step-item:last-child {
  border-bottom: none;
}

.step-num {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: var(--color-primary);
  border-radius: 50%;
  flex-shrink: 0;
}

.step-content {
  flex: 1;
}

.step-text {
  display: block;
  font-size: 26rpx;
  color: var(--color-text);
  line-height: 1.5;
}

.step-meta {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

/* ==================== 图例 ==================== */

.legend {
  margin: 24rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.legend-title {
  font-size: 24rpx;
  color: var(--color-text-muted);
  flex-shrink: 0;
}

.legend-items {
  display: flex;
  gap: 24rpx;
  flex-wrap: wrap;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-dot.level-1 { background: #c0392b; }
.legend-dot.level-2 { background: #e67e22; }
.legend-dot.level-3 { background: #27ae60; }

/* ==================== 产区列表 ==================== */

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 24rpx 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.section-count {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--color-text-muted);
}

.region-list {
  margin: 0 24rpx;
}

.region-card {
  margin: 0 0 20rpx;
  padding: 24rpx;
}

.level-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: 20rpx;
  color: #fff;
  font-weight: 500;
  white-space: nowrap;
}

.level-badge.level-1 { background: linear-gradient(135deg, #c0392b, #e74c3c); }
.level-badge.level-2 { background: linear-gradient(135deg, #d35400, #e67e22); }
.level-badge.level-3 { background: linear-gradient(135deg, #27ae60, #2ecc71); }

.region-top {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.region-name-info {
  flex: 1;
  min-width: 0;
}

.region-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 4rpx;
}

.region-meta-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.region-location {
  display: inline;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.region-distance {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 500;
}

.region-char {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 16rpx;
  line-height: 1.5;
  padding: 12rpx 16rpx;
  background: var(--color-bg);
  border-radius: var(--radius-md);
  border-left: 4rpx solid var(--color-primary);
}

/* 数据指标行 */
.region-metrics {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.metric-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 16rpx;
  background: linear-gradient(135deg, #f8f9fa, #e9ecef);
  border-radius: var(--radius-md);
}

.metric-icon {
  font-size: 28rpx;
  flex-shrink: 0;
}

.metric-content {
  flex: 1;
  min-width: 0;
}

.metric-label {
  display: block;
  font-size: 20rpx;
  color: var(--color-text-muted);
  margin-bottom: 2rpx;
}

.metric-value {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.region-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.brand-tag {
  font-size: 20rpx;
  color: var(--color-primary);
  background: #eef5ec;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-full);
  border: 1rpx solid rgba(45, 90, 39, 0.1);
}

.region-arrow {
  font-size: 36rpx;
  color: #d0d0d0;
  flex-shrink: 0;
  margin-top: 4rpx;
}

/* ==================== 详情弹窗 — 使用全局样式 (含 slideUp 动画) ==================== */

.detail-handle {
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
}

.handle-icon {
  font-size: 32rpx;
  color: #d0d0d0;
  padding: 8rpx 16rpx;
}

.detail-header {
  text-align: center;
  margin-bottom: 20rpx;
}

.detail-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  margin: 12rpx 0 8rpx;
}

.detail-location {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.detail-distance {
  display: block;
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 500;
  margin-top: 8rpx;
}

/* 导航按钮 */
.nav-buttons {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.nav-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 0;
  border-radius: var(--radius-lg);
  transition: all 0.2s;
}

.nav-driving {
  background: linear-gradient(135deg, #2d5a27, #4a8c3f);
}

.nav-walking {
  background: linear-gradient(135deg, #2980b9, #3498db);
}

.nav-bicycling {
  background: linear-gradient(135deg, #d35400, #e67e22);
}

.nav-btn-icon {
  font-size: 36rpx;
}

.nav-btn-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
}

.detail-divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 0 -32rpx 24rpx;
}

.detail-section {
  margin-bottom: 24rpx;
}

.detail-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-bottom: 8rpx;
}

.detail-text {
  display: block;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.detail-highlight {
  background: linear-gradient(135deg, #f5f0e6, #e8dfd0);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
}

.detail-highlight text {
  font-size: 28rpx;
  color: var(--color-primary-dark);
  line-height: 1.5;
}

.info-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.info-item {
  flex: 1;
  background: var(--color-bg);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.info-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

.info-label {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.info-value {
  font-size: 26rpx;
  color: var(--color-text);
  font-weight: 500;
  line-height: 1.3;
}

.brands-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.brand-chip {
  font-size: 24rpx;
  color: var(--color-primary);
  background: #eef5ec;
  border: 1rpx solid rgba(45, 90, 39, 0.15);
  padding: 8rpx 18rpx;
  border-radius: var(--radius-full);
}
