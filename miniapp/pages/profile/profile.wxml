<view class="page">
  <!-- 顶部背景 -->
  <view class="header-bg">
    <view class="header-pattern">
      <text class="pattern-leaf">🍃</text>
      <text class="pattern-leaf leaf-2">🍵</text>
      <text class="pattern-leaf leaf-3">🍃</text>
    </view>
    <view class="header-wave"></view>
  </view>

  <!-- 用户信息区 -->
  <view class="profile-section">
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image class="avatar" src="{{userInfo.avatar || defaultAvatar}}" mode="aspectFill" />
      <view class="avatar-edit">编辑</view>
    </button>
    <input class="nickname" type="nickname" placeholder="点击设置昵称" value="{{userInfo.nickname}}" bindblur="onNickname" />
    <view class="user-badge">
      <text class="badge-icon">🍵</text>
      <text>六堡茶文化爱好者</text>
    </view>

    <!-- 数据统计 -->
    <view class="stats-row">
      <view class="stat-item" bindtap="goHistory">
        <text class="stat-num">{{stats.recognition}}</text>
        <text class="stat-label">识别次数</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="goHistory">
        <text class="stat-num">{{stats.qa}}</text>
        <text class="stat-label">问答次数</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="goFavorites">
        <text class="stat-num">{{stats.favorite}}</text>
        <text class="stat-label">我的收藏</text>
      </view>
    </view>
  </view>

  <!-- 服务菜单 -->
  <view class="section-title">我的服务</view>
  <view class="menu-list card">
    <view class="menu-row" bindtap="goHistory">
      <view class="row-left">
        <view class="row-icon icon-history">📋</view>
        <view class="row-text">
          <text class="row-title">历史记录</text>
          <text class="row-desc">查看识别与问答记录</text>
        </view>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goFavorites">
      <view class="row-left">
        <view class="row-icon icon-fav">⭐</view>
        <view class="row-text">
          <text class="row-title">我的收藏</text>
          <text class="row-desc">收藏的知识与回答</text>
        </view>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goKnowledge">
      <view class="row-left">
        <view class="row-icon icon-kb">📚</view>
        <view class="row-text">
          <text class="row-title">知识库</text>
          <text class="row-desc">六堡茶文化百科</text>
        </view>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="footer-text">茶侦探 · 用 AI 解锁茶文化</view>
</view>
