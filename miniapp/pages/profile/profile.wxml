<view class="page">
  <!-- 顶部背景 -->
  <view class="header-bg">
    <view class="header-pattern">
      <text class="pattern-leaf">🍃</text>
      <text class="pattern-leaf leaf-2">🍵</text>
      <text class="pattern-leaf leaf-3">🍃</text>
    </view>
    <view class="header-wave"></view>
  </view>

  <!-- 用户信息区 -->
  <view class="profile-section">
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image class="avatar" src="{{userInfo.avatar || defaultAvatar}}" mode="aspectFill" />
      <view class="avatar-edit">编辑</view>
    </button>
    <input class="nickname" type="nickname" placeholder="点击设置昵称" value="{{userInfo.nickname}}" bindblur="onNickname" />
    <view class="user-badge">
      <text class="badge-icon">🍵</text>
      <text>六堡茶文化爱好者</text>
    </view>

    <!-- 数据统计 -->
    <view class="stats-row">
      <view class="stat-item" bindtap="goHistory">
        <text class="stat-num">{{stats.recognition}}</text>
        <text class="stat-label">识别次数</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="goHistory">
        <text class="stat-num">{{stats.qa}}</text>
        <text class="stat-label">问答次数</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item" bindtap="goFavorites">
        <text class="stat-num">{{stats.favorite}}</text>
        <text class="stat-label">我的收藏</text>
      </view>
    </view>
  </view>

  <!-- 服务菜单 -->
  <view class="section-title">我的服务</view>
  <view class="menu-list card">
    <view class="menu-row" bindtap="goHistory">
      <view class="row-left">
        <view class="row-icon icon-history">📋</view>
        <view class="row-text">
          <text class="row-title">历史记录</text>
          <text class="row-desc">查看识别与问答记录</text>
        </view>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goStats">
      <view class="row-left">
        <view class="row-icon icon-stats">📊</view>
        <view class="row-text">
          <text class="row-title">识别统计</text>
          <text class="row-desc">查看识别数据可视化</text>
        </view>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goFavorites">
      <view class="row-left">
        <view class="row-icon icon-fav">⭐</view>
        <view class="row-text">
          <text class="row-title">我的收藏</text>
          <text class="row-desc">收藏的知识与回答</text>
        </view>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goKnowledge">
      <view class="row-left">
        <view class="row-icon icon-kb">📚</view>
        <view class="row-text">
          <text class="row-title">知识库</text>
          <text class="row-desc">六堡茶文化百科</text>
        </view>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-row" bindtap="goJournal">
      <view class="row-left">
        <view class="row-icon icon-journal">📝</view>
        <view class="row-text">
          <text class="row-title">品茶日记</text>
          <text class="row-desc">我的品茶记录</text>
        </view>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 识别统计卡片（内嵌展示） -->
  <view class="section-title" wx:if="{{recognitionStats.total > 0}}">识别数据</view>
  <view class="stats-card card" wx:if="{{recognitionStats.total > 0}}">
    <!-- 概览数字 -->
    <view class="stats-overview">
      <view class="overview-item">
        <text class="overview-num">{{recognitionStats.total}}</text>
        <text class="overview-label">总识别</text>
      </view>
      <view class="overview-item">
        <text class="overview-num normal">{{recognitionStats.normal_count}}</text>
        <text class="overview-label">正常</text>
      </view>
      <view class="overview-item">
        <text class="overview-num warning">{{recognitionStats.abnormal_count}}</text>
        <text class="overview-label">异常</text>
      </view>
    </view>

    <!-- 饼图：正常/异常比例 -->
    <view class="pie-section" wx:if="{{recognitionStats.total > 0}}">
      <text class="chart-title">正常/异常分布</text>
      <view class="pie-wrap">
        <view class="pie-bar">
          <view
            class="pie-fill normal"
            style="width: {{recognitionStats.total > 0 ? (recognitionStats.normal_count / recognitionStats.total * 100) : 0}}%"
          ></view>
        </view>
        <view class="pie-legend">
          <view class="legend-item">
            <view class="legend-dot normal"></view>
            <text>正常 {{recognitionStats.normal_count}}</text>
          </view>
          <view class="legend-item">
            <view class="legend-dot warning"></view>
            <text>异常 {{recognitionStats.abnormal_count}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 柱状图：月度趋势 -->
    <view class="bar-section" wx:if="{{recognitionStats.monthly.length > 0}}">
      <text class="chart-title">近月识别趋势</text>
      <view class="bar-chart">
        <view class="bar-row" wx:for="{{recognitionStats.monthly}}" wx:key="raw">
          <text class="bar-label">{{item.month}}</text>
          <view class="bar-track">
            <view
              class="bar-fill"
              style="width: {{item.count > 0 ? (item.count / barMaxCount * 100) : 0}}%"
            ></view>
          </view>
          <text class="bar-val">{{item.count}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 收藏列表 -->
  <view class="fav-section" wx:if="{{showFav}}">
    <view class="fav-section-header">
      <view class="section-title">收藏列表</view>
      <text class="fav-close" bindtap="closeFavorites">收起</text>
    </view>
    <!-- 收藏加载中 -->
    <view class="fav-loading" wx:if="{{favLoading}}">
      <view class="loading-spinner"></view>
      <text>加载中...</text>
    </view>
    <!-- 收藏列表 -->
    <block wx:if="{{!favLoading}}">
      <view class="fav-item card" wx:for="{{favorites}}" wx:key="id">
        <view class="fav-header">
          <text class="fav-title">{{item.title}}</text>
          <text class="fav-type">{{item.fav_type}}</text>
        </view>
        <text class="fav-content">{{item.content}}</text>
        <button class="fav-remove" size="mini" data-id="{{item.id}}" bindtap="removeFav">取消收藏</button>
      </view>
      <view class="empty-state" wx:if="{{!favorites.length}}">暂无收藏内容</view>
    </block>
  </view>

  <view class="footer-text">茶侦探 · 用 AI 解锁茶文化</view>
</view>
