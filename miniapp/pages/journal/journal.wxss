.page { min-height: 100vh; padding-bottom: 120rpx; }

.page-header {
  background: linear-gradient(160deg, var(--color-primary-dark), var(--color-primary), var(--color-primary-light));
  padding: 40rpx 32rpx 32rpx;
}
.page-title { display: block; font-size: 36rpx; font-weight: 700; color: #fff; }
.page-sub { display: block; font-size: 24rpx; color: rgba(255,255,255,0.75); margin-top: 4rpx; }

.timeline { padding: 24rpx; }

.journal-card { margin-bottom: 20rpx; transition: transform 0.15s; }
.journal-card:active { transform: scale(0.98); }
.card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.card-left { display: flex; align-items: center; gap: 12rpx; }
.tea-name { font-size: 32rpx; font-weight: 600; color: var(--color-text); }
.tea-type-tag { font-size: 20rpx; color: var(--color-primary); background: #eef5ec; padding: 4rpx 12rpx; border-radius: var(--radius-full); }
.stars { font-size: 24rpx; }

.card-body { display: flex; gap: 16rpx; }
.thumb { width: 120rpx; height: 120rpx; border-radius: var(--radius-md); flex-shrink: 0; }
.card-info { flex: 1; min-width: 0; }
.flavor-text { display: block; font-size: 22rpx; color: var(--color-primary); margin-bottom: 8rpx; }
.notes-preview { font-size: 26rpx; color: var(--color-text-secondary); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.5; }

.card-footer { margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx solid #f5f5f5; }
.date { font-size: 22rpx; color: var(--color-text-muted); }

.empty-icon { font-size: 64rpx; display: block; margin-bottom: 16rpx; }
.empty-sub { font-size: 24rpx; color: var(--color-text-muted); margin-top: 8rpx; }

.fab { position: fixed; right: 40rpx; bottom: 120rpx; width: 100rpx; height: 100rpx; background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary)); border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 24rpx rgba(45,90,39,0.35); z-index: 100; transition: transform 0.15s; }
.fab:active { transform: scale(0.9); }
.fab-icon { font-size: 40rpx; }

.detail-mask { position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 998; display: flex; align-items: flex-end; }
.detail-sheet { width: 100%; background: var(--color-card); border-radius: var(--radius-lg) var(--radius-lg) 0 0; padding: 0 32rpx 64rpx; max-height: 80vh; overflow-y: auto; }
.detail-handle { text-align: center; padding: 20rpx 0; font-size: 32rpx; color: #d0d0d0; }
.detail-header { text-align: center; margin-bottom: 20rpx; }
.detail-name { display: block; font-size: 36rpx; font-weight: 700; color: var(--color-text); margin-bottom: 12rpx; }
.detail-info { margin-bottom: 20rpx; }
.info-row { display: block; font-size: 26rpx; color: var(--color-text-secondary); margin-bottom: 8rpx; }
.detail-notes { margin-bottom: 20rpx; }
.notes-label { display: block; font-size: 24rpx; color: var(--color-text-muted); margin-bottom: 8rpx; }
.notes-text { font-size: 28rpx; color: var(--color-text-secondary); line-height: 1.7; }
.detail-img { width: 100%; border-radius: var(--radius-md); margin-bottom: 20rpx; }
.detail-actions { text-align: center; padding-top: 16rpx; }
.delete-btn { background: #fff; color: #e74c3c; border: 1rpx solid #e74c3c; font-size: 24rpx; }
.delete-btn::after { border: none; }
