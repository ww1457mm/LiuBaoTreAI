.page { min-height: 100vh; padding-bottom: 40rpx; }

.form { margin: 24rpx; }

.field { margin-bottom: 28rpx; }
.field-row { display: flex; gap: 16rpx; margin-bottom: 28rpx; }
.field.half { flex: 1; }

.label { display: block; font-size: 26rpx; color: var(--color-text-secondary); margin-bottom: 12rpx; font-weight: 500; }

.input { height: 80rpx; background: var(--color-bg); border-radius: var(--radius-md); padding: 0 20rpx; font-size: 28rpx; }
.textarea { width: 100%; min-height: 160rpx; background: var(--color-bg); border-radius: var(--radius-md); padding: 16rpx 20rpx; font-size: 28rpx; box-sizing: border-box; }

.type-scroll { white-space: nowrap; }
.type-list { display: inline-flex; gap: 12rpx; }
.type-tag { display: inline-block; font-size: 24rpx; padding: 12rpx 24rpx; background: var(--color-bg); border-radius: var(--radius-full); color: var(--color-text-secondary); border: 2rpx solid transparent; }
.type-tag.active { background: #eef5ec; color: var(--color-primary); border-color: var(--color-primary); }

.flavor-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.flavor-tag { font-size: 24rpx; padding: 10rpx 20rpx; background: var(--color-bg); border-radius: var(--radius-full); color: var(--color-text-secondary); border: 2rpx solid transparent; }
.flavor-tag.active { background: #eef5ec; color: var(--color-primary); border-color: var(--color-primary); }

.img-area { width: 200rpx; height: 200rpx; border-radius: var(--radius-md); overflow: hidden; background: var(--color-bg); }
.preview-img { width: 100%; height: 100%; }
.img-placeholder { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; }
.img-icon { font-size: 40rpx; }
.img-text { font-size: 22rpx; color: var(--color-text-muted); }

.save-btn { margin: 32rpx 24rpx; height: 88rpx; line-height: 88rpx; }
