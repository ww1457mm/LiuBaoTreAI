<view class="page">
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:if="{{!loading}}">
    <view class="fav-item card" wx:for="{{favorites}}" wx:key="id">
      <view class="fav-header">
        <text class="fav-title">{{item.title}}</text>
        <text class="fav-type">{{item.typeLabel}}</text>
      </view>
      <text class="fav-content">{{item.content}}</text>
      <button class="fav-remove" size="mini" data-id="{{item.id}}" bindtap="removeFav">取消收藏</button>
    </view>
    <view class="empty-state" wx:if="{{!favorites.length}}">
      <text class="empty-icon">⭐</text>
      <text class="empty-title">暂无收藏</text>
      <text class="empty-sub">在知识库或问答中收藏内容后会显示在这里</text>
    </view>
  </block>
</view>
