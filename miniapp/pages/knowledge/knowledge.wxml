<view class="page">
  <view class="search-bar">
    <input placeholder="搜索知识库" value="{{keyword}}" bindinput="onSearchInput" bindconfirm="doSearch" />
    <button size="mini" class="search-btn" bindtap="doSearch">搜索</button>
  </view>

  <scroll-view class="categories" scroll-x>
    <text class="cat {{!category?'active':''}}" data-cat="" bindtap="filterCat">全部</text>
    <text class="cat {{category===item?'active':''}}" wx:for="{{categories}}" wx:key="*this" data-cat="{{item}}" bindtap="filterCat">{{item}}</text>
  </scroll-view>

  <view class="list">
    <view class="item card" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <text class="item-title">{{item.title}}</text>
      <text class="item-cat">{{item.category}}</text>
      <text class="item-content">{{item.content}}</text>
    </view>
    <view class="empty" wx:if="{{!loading && list.length===0}}">暂无内容</view>
  </view>
</view>
