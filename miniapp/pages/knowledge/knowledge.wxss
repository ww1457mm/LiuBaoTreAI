.page {
  padding-bottom: 40rpx;
}

/* 搜索 */
.search-bar {
  display: flex;
  padding: 24rpx;
  align-items: center;
  gap: 16rpx;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: var(--color-card);
  border-radius: var(--radius-full);
  padding: 0 24rpx;
  border: 1rpx solid var(--color-border);
  box-shadow: var(--shadow-sm);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  padding: 18rpx 0;
  font-size: 28rpx;
}

.search-btn {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  font-size: 26rpx;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: var(--radius-full);
  border: none;
}

.search-btn::after { border: none; }

/* 分类 */
.categories {
  white-space: nowrap;
  padding-bottom: 8rpx;
}

.cat-list {
  display: inline-flex;
  padding: 0 24rpx;
  gap: 12rpx;
}

.cat {
  display: inline-block;
  padding: 12rpx 28rpx;
  background: var(--color-card);
  border-radius: var(--radius-full);
  font-size: 26rpx;
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
  transition: all 0.2s;
}

.cat.active {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  border-color: transparent;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(45, 90, 39, 0.2);
}

/* 列表项 */
.item {
  transition: transform 0.15s;
}

.item:active {
  transform: scale(0.98);
}

.item-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.item-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  flex: 1;
}

.item-cat {
  font-size: 22rpx;
  color: var(--color-primary);
  background: #eef5ec;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.item-content {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-footer {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f5f5f5;
}

.read-more {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 500;
}

/* 加载状态 — 使用全局 .loading-wrap / .loading-spinner */
