<view class="page">
  <!-- 顶部标题 -->
  <view class="page-hero">
    <text class="hero-title">🔬 AI 病虫害检测</text>
    <text class="hero-desc">拍照识别茶叶病害与虫害，获取处理建议</text>
  </view>

  <!-- 图片预览区 -->
  <view class="preview-area">
    <view class="preview-card" wx:if="{{imagePath}}">
      <image class="preview-img" src="{{imagePath}}" mode="aspectFit" />
      <view class="preview-overlay" wx:if="{{loading}}">
        <view class="scan-line"></view>
        <view class="loading-ring"></view>
        <text class="loading-label">AI 识别中...</text>
      </view>
    </view>
    <view class="preview-card placeholder" wx:else bindtap="chooseImage">
      <view class="placeholder-ring">
        <text class="placeholder-icon">📷</text>
      </view>
      <text class="placeholder-title">点击拍照或上传图片</text>
      <text class="placeholder-hint">支持 JPG / PNG 格式</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <button class="btn-action primary" bindtap="takePhoto">
      <text class="btn-emoji">📷</text>
      <text>拍照识别</text>
    </button>
    <button class="btn-action secondary" bindtap="chooseImage">
      <text class="btn-emoji">🖼️</text>
      <text>相册选择</text>
    </button>
  </view>

  <!-- 识别结果 -->
  <view class="result-area" wx:if="{{result}}">
    <view class="result-card">
      <!-- 结果头部 -->
      <view class="result-header">
        <view class="result-status {{result.category.indexOf('未检出') >= 0 || result.category.indexOf('正常') >= 0 ? 'status-ok' : 'status-warn'}}">
          <text class="status-icon">{{result.category.indexOf('未检出') >= 0 || result.category.indexOf('正常') >= 0 ? '✅' : '⚠️'}}</text>
          <text class="status-text">{{result.category}}</text>
        </view>
        <view class="confidence-bar">
          <text class="confidence-label">置信度</text>
          <text class="confidence-value">{{result.confidenceText || result.confidence}}</text>
        </view>
      </view>

      <!-- 置信度进度条 -->
      <view class="progress-track">
        <view class="progress-fill {{result.category.indexOf('未检出') >= 0 || result.category.indexOf('正常') >= 0 ? 'fill-ok' : 'fill-warn'}}" style="width: {{result.confidencePercent || 0}}%"></view>
      </view>

      <!-- 描述 -->
      <view class="result-section" wx:if="{{result.description}}">
        <text class="section-label">📋 描述</text>
        <text class="section-text">{{result.description}}</text>
      </view>

      <!-- 建议 -->
      <view class="result-section suggestion" wx:if="{{result.suggestion}}">
        <text class="section-label">💡 建议</text>
        <text class="section-text">{{result.suggestion}}</text>
      </view>
    </view>
  </view>
</view>
