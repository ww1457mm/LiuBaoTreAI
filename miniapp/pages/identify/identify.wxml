<view class="page">
  <!-- 任务切换 -->
  <view class="task-tabs">
    <view class="tab {{task==='variety'?'active':''}}" data-task="variety" bindtap="switchTask">
      <text class="tab-icon">🌿</text>
      <text>品种识别</text>
    </view>
    <view class="tab {{task==='grade'?'active':''}}" data-task="grade" bindtap="switchTask">
      <text class="tab-icon">⭐</text>
      <text>等级识别</text>
    </view>
    <view class="tab {{task==='disease'?'active':''}}" data-task="disease" bindtap="switchTask">
      <text class="tab-icon">🔍</text>
      <text>病害识别</text>
    </view>
  </view>

  <!-- 图片预览区 -->
  <view class="preview-wrap">
    <view class="preview card" wx:if="{{imagePath}}">
      <image class="preview-img" src="{{imagePath}}" mode="aspectFit" />
      <view class="preview-overlay" wx:if="{{loading}}">
        <view class="loading-spinner"></view>
        <text>识别中...</text>
      </view>
    </view>
    <view class="preview card placeholder" wx:else>
      <view class="placeholder-icon">📸</view>
      <text class="placeholder-title">拍照或上传茶叶图片</text>
      <text class="placeholder-hint">支持 JPG、PNG 格式</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <button class="btn-primary action-btn" bindtap="takePhoto">
      <text class="btn-icon">📷</text>
      <text>拍照识别</text>
    </button>
    <button class="btn-secondary action-btn" bindtap="chooseImage">
      <text class="btn-icon">🖼️</text>
      <text>相册选择</text>
    </button>
  </view>

  <!-- 识别结果 -->
  <view class="result card" wx:if="{{result}}">
    <view class="result-header">
      <text class="result-title">识别结果</text>
      <view class="confidence-badge">{{result.confidence}}</view>
    </view>
    <view class="result-body">
      <view class="result-row">
        <text class="label">类别</text>
        <text class="value">{{result.category}}</text>
      </view>
      <view class="result-divider"></view>
      <view class="desc-block">
        <text class="block-label">描述</text>
        <text class="desc">{{result.description}}</text>
      </view>
      <view class="suggestion-block">
        <text class="block-label">💡 建议</text>
        <text class="suggestion">{{result.suggestion}}</text>
      </view>
    </view>
  </view>
</view>
