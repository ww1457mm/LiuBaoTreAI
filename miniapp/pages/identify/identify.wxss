.task-tabs { display: flex; margin: 20rpx; background: #fff; border-radius: 12rpx; overflow: hidden; }
.tab { flex: 1; text-align: center; padding: 20rpx; font-size: 26rpx; color: #666; }
.tab.active { background: #2d5a27; color: #fff; }

.preview { min-height: 400rpx; display: flex; align-items: center; justify-content: center; }
.preview.placeholder { color: #999; }
.preview-img { width: 100%; height: 400rpx; }

.actions { padding: 0 20rpx 20rpx; }
.actions button { margin-bottom: 16rpx; }
.btn-secondary { background: #fff; color: #2d5a27; border: 2rpx solid #2d5a27; border-radius: 12rpx; }

.result-title { font-size: 32rpx; font-weight: 600; color: #2d5a27; display: block; margin-bottom: 16rpx; }
.row { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid #eee; }
.label { color: #999; }
.value { color: #2d5a27; font-weight: 600; }
.desc, .suggestion { font-size: 26rpx; color: #666; line-height: 1.6; margin-top: 16rpx; }
.suggestion { color: #3d7a35; }
