.page {
  padding-bottom: 40rpx;
}

/* 任务标签 */
.task-tabs {
  display: flex;
  margin: 24rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 8rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--color-border);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.tab-icon {
  font-size: 28rpx;
}

.tab.active {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(45, 90, 39, 0.3);
}

/* 预览区 */
.preview-wrap {
  margin: 0 24rpx;
}

.preview {
  min-height: 440rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  margin: 0;
}

.preview.placeholder {
  flex-direction: column;
  border: 2rpx dashed #d4e0d2;
  background: var(--color-bg-warm);
}

.placeholder-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

.placeholder-title {
  font-size: 30rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.placeholder-hint {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-top: 8rpx;
}

.preview-img {
  width: 100%;
  height: 440rpx;
  border-radius: var(--radius-md);
}

.preview-overlay {
  position: absolute;
  inset: 0;
  background: rgba(30, 61, 26, 0.6);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  gap: 16rpx;
  border-radius: var(--radius-lg);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 操作按钮 */
.actions {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
}

.btn-icon {
  font-size: 32rpx;
}

/* 识别结果 */
.result {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.confidence-badge {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
}

.result-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.label {
  color: var(--color-text-muted);
  font-size: 26rpx;
}

.value {
  color: var(--color-primary);
  font-weight: 700;
  font-size: 32rpx;
}

.result-divider {
  height: 1rpx;
  background: var(--color-border);
  margin: 8rpx 0;
}

.block-label {
  font-size: 24rpx;
  color: var(--color-text-muted);
  display: block;
  margin-bottom: 8rpx;
}

.desc-block, .suggestion-block {
  margin-top: 20rpx;
}

.desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
}

.suggestion-block {
  background: #f0f7ee;
  border-radius: var(--radius-md);
  padding: 20rpx;
  border-left: 6rpx solid var(--color-primary);
}

.suggestion {
  font-size: 26rpx;
  color: var(--color-primary);
  line-height: 1.7;
}
