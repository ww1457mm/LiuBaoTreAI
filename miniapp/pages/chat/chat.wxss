/**
 * 聊天页面样式 - AI 问答功能的界面样式
 *
 * 样式结构：
 * 1. 页面布局（Flexbox 垂直布局）
 * 2. 聊天列表（可滚动区域）
 * 3. 欢迎区域（无消息时显示）
 * 4. 消息行（用户消息 + AI 回答）
 * 5. 头像样式
 * 6. 消息气泡样式
 * 7. 参考来源样式
 * 8. 打字动画
 * 9. 快捷问题标签
 * 10. 输入栏样式
 *
 * 设计特点：
 * - 使用 CSS 变量（--color-*）实现主题一致性
 * - 使用 rpx 单位实现响应式布局
 * - 使用 Flexbox 实现灵活布局
 * - 使用动画增强用户体验
 */

/* ==================== 页面布局 ==================== */

.page {
  /* Flexbox 垂直布局 */
  display: flex;
  flex-direction: column;
  /* 占满整个视口高度 */
  height: 100vh;
  /* 背景色 */
  background: var(--color-bg);
}

/* ==================== 聊天列表 ==================== */

.chat-list {
  /* 占据剩余空间 */
  flex: 1;
  /* 内边距 */
  padding: 24rpx;
  /* 盒模型包含 padding */
  box-sizing: border-box;
}

/* ==================== 欢迎区域 ==================== */

.welcome {
  /* Flexbox 垂直居中布局 */
  display: flex;
  flex-direction: column;
  align-items: center;
  /* 内边距：顶部较大，底部较小 */
  padding: 80rpx 40rpx 40rpx;
  text-align: center;
  /* 淡入上移动画 */
  animation: fadeUp 0.6s var(--ease-out);
}

.welcome-icon {
  /* 大图标 */
  font-size: 80rpx;
  margin-bottom: 24rpx;
  /* 浮动动画 */
  animation: float 3s ease-in-out infinite;
}

/* 浮动动画：上下移动 */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

.welcome-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.welcome-text {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-muted);
  line-height: 1.7;
  margin-bottom: 32rpx;
  /* 限制最大宽度 */
  max-width: 560rpx;
}

.welcome-tags {
  /* Flexbox 自动换行布局 */
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
}

.wtag {
  font-size: 24rpx;
  color: var(--color-primary);
  background: var(--color-card);
  padding: 12rpx 24rpx;
  /* 圆角胶囊形状 */
  border-radius: var(--radius-full);
  border: 1rpx solid rgba(45, 90, 39, 0.12);
  /* 过渡动画 */
  transition: transform 0.2s var(--ease-bounce), background 0.15s;
}

/* 按下效果 */
.wtag:active {
  transform: scale(0.95);
  background: #eef5ec;
}

/* ==================== 消息行 ==================== */

.msg-row {
  /* Flexbox 水平布局 */
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
  align-items: flex-start;
  /* 消息滑入动画 */
  animation: msgSlideIn 0.3s var(--ease-out);
}

/* 消息滑入动画 */
@keyframes msgSlideIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 用户消息：右对齐 */
.msg-row.user {
  flex-direction: row;
  justify-content: flex-end;
}

/* ==================== 头像 ==================== */

.avatar {
  /* 固定尺寸 */
  width: 64rpx;
  height: 64rpx;
  /* 圆角 */
  border-radius: 20rpx;
  /* 渐变背景 */
  background: linear-gradient(135deg, #e8f5e6, #c8e6c3);
  /* Flexbox 居中 */
  display: flex;
  align-items: center;
  justify-content: center;
  /* 防止缩小 */
  flex-shrink: 0;
  box-shadow: var(--shadow-xs);
}

/* 用户头像：蓝色渐变 */
.user-avatar {
  background: linear-gradient(135deg, #e3f2fd, #bbdefb);
}

.avatar-emoji {
  font-size: 28rpx;
}

/* ==================== 消息气泡 ==================== */

.msg-body {
  /* 最大宽度限制 */
  max-width: 75%;
  min-width: 0;
}

.bubble {
  /* 内边距 */
  padding: 20rpx 28rpx;
  /* 圆角 */
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
  /* 长单词换行 */
  word-break: break-all;
  position: relative;
}

/* AI 气泡：白色背景 */
.bubble.assistant {
  background: var(--color-card);
  color: var(--color-text);
  /* 左下角小圆角 */
  border-bottom-left-radius: 8rpx;
  box-shadow: var(--shadow-xs);
  border: 1rpx solid var(--color-border);
}

/* 用户气泡：绿色渐变 */
.bubble.user {
  background: linear-gradient(135deg, #4a8c3f, #2d5a27);
  color: #fff;
  /* 右下角小圆角 */
  border-bottom-right-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(45, 90, 39, 0.2);
}

.bubble-text {
  display: block;
}

/* ==================== 参考来源 ==================== */

.refs {
  margin-top: 12rpx;
  background: var(--color-bg-warm);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--color-border);
}

.refs-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.refs-icon {
  font-size: 22rpx;
}

.refs-title {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.ref-item {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.ref-text {
  font-size: 24rpx;
  color: var(--color-primary);
  /* 占据剩余空间 */
  flex: 1;
}

.ref-source {
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.recommend {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  /* 渐变背景 */
  background: linear-gradient(135deg, #f5f0e6, #e8dfd0);
  border-radius: var(--radius-sm);
}

.recommend-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-accent);
}

.recommend-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ==================== 打字动画 ==================== */

.typing-bubble {
  display: flex;
  gap: 10rpx;
  padding: 24rpx 32rpx;
  background: var(--color-card);
  border-radius: 24rpx;
  border-bottom-left-radius: 8rpx;
  box-shadow: var(--shadow-xs);
  border: 1rpx solid var(--color-border);
}

.typing-dot {
  /* 小圆点 */
  width: 14rpx;
  height: 14rpx;
  background: var(--color-primary);
  border-radius: 50%;
  opacity: 0.4;
  /* 弹跳动画 */
  animation: typingBounce 1.4s ease-in-out infinite;
}

/* 延迟动画：错开时间 */
.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

/* 弹跳动画 */
@keyframes typingBounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-10rpx); opacity: 1; }
}

/* ==================== 快捷问题 ==================== */

.quick-scroll {
  /* 防止缩小 */
  flex-shrink: 0;
  border-top: 1rpx solid var(--color-divider);
  background: var(--color-card);
}

.quick-questions {
  /* 行内 Flexbox，允许水平滚动 */
  display: inline-flex;
  padding: 16rpx 24rpx;
  gap: 12rpx;
  /* 防止换行 */
  white-space: nowrap;
}

.quick-tag {
  display: inline-block;
  font-size: 24rpx;
  color: var(--color-primary);
  background: #eef5ec;
  padding: 10rpx 24rpx;
  /* 圆角胶囊 */
  border-radius: var(--radius-full);
  border: 1rpx solid rgba(45, 90, 39, 0.1);
  transition: transform 0.2s var(--ease-bounce), background 0.15s;
}

/* 按下效果 */
.quick-tag:active {
  transform: scale(0.95);
  background: #d4e8cf;
}

/* ==================== 输入栏 ==================== */

.input-bar {
  /* Flexbox 水平布局 */
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  /* 适配 iPhone 底部安全区 */
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-card);
  border-top: 1rpx solid var(--color-divider);
}

.input-wrap {
  /* 占据剩余空间 */
  flex: 1;
  background: var(--color-bg);
  /* 圆角胶囊 */
  border-radius: var(--radius-full);
  padding: 0 28rpx;
  height: 80rpx;
  /* 透明边框，聚焦时显示 */
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

/* 聚焦时边框高亮 */
.input-wrap:focus-within {
  border-color: rgba(45, 90, 39, 0.3);
}

.input {
  height: 80rpx;
  font-size: 28rpx;
  line-height: 80rpx;
}

.input-placeholder {
  color: var(--color-text-muted);
}

.send-btn {
  /* 圆形按钮 */
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  /* 默认灰色 */
  background: #e0e0e0;
  /* Flexbox 居中 */
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 0.2s var(--ease-bounce), background 0.2s, box-shadow 0.2s;
}

/* 激活状态：绿色渐变 */
.send-btn.active {
  background: linear-gradient(135deg, #4a8c3f, #2d5a27);
  box-shadow: 0 4rpx 16rpx rgba(45, 90, 39, 0.3);
}

/* 按下效果 */
.send-btn:active {
  transform: scale(0.9);
}

.send-icon {
  font-size: 36rpx;
  color: #fff;
  font-weight: 700;
}

/* 淡入上移动画 */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}
