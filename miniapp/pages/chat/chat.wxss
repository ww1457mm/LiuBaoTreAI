.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg);
}

/* 聊天列表 */
.chat-list {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 欢迎卡片 */
.welcome-card {
  display: flex;
  gap: 20rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--color-border);
  margin-bottom: 24rpx;
}

.bot-avatar {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #e8f5e6, #c8e6c3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.welcome-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-primary);
  display: block;
  margin-bottom: 8rpx;
}

.welcome-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.7;
}

/* 消息行 */
.msg-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
  align-items: flex-start;
}

.msg-row.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #e8f5e6, #c8e6c3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.user-avatar {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
}

.msg-body {
  max-width: 72%;
}

.bubble {
  display: inline-block;
  padding: 20rpx 28rpx;
  border-radius: var(--radius-lg);
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-all;
}

.user .bubble {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  border-bottom-right-radius: 6rpx;
  box-shadow: 0 4rpx 16rpx rgba(45, 90, 39, 0.2);
}

.assistant .bubble {
  background: var(--color-card);
  color: var(--color-text);
  border-bottom-left-radius: 6rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--color-border);
}

/* 打字动画 */
.typing-bubble {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--color-card);
  padding: 24rpx 28rpx;
  border-radius: var(--radius-lg);
  border-bottom-left-radius: 6rpx;
  box-shadow: var(--shadow-sm);
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: var(--color-primary-light);
  border-radius: 50%;
  animation: bounce 1.2s infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes bounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-8rpx); opacity: 1; }
}

/* 参考来源 */
.refs {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  background: #f0f7ee;
  border-radius: var(--radius-md);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  border: 1rpx solid #d4e8cf;
}

.refs-title {
  font-weight: 600;
  color: var(--color-primary);
  display: block;
  margin-bottom: 8rpx;
}

.ref-item {
  margin-top: 6rpx;
  line-height: 1.5;
}

.recommend {
  margin-top: 10rpx;
  color: var(--color-primary);
  font-weight: 500;
}

/* 快捷问题 */
.quick-scroll {
  white-space: nowrap;
  padding: 12rpx 0;
  background: var(--color-bg-warm);
  border-top: 1rpx solid var(--color-border);
}

.quick-questions {
  display: inline-flex;
  padding: 0 20rpx;
  gap: 12rpx;
}

.quick-tag {
  display: inline-block;
  font-size: 24rpx;
  background: var(--color-card);
  color: var(--color-primary);
  padding: 12rpx 24rpx;
  border-radius: var(--radius-full);
  border: 1rpx solid #c5dcc0;
  white-space: nowrap;
  box-shadow: var(--shadow-sm);
}

/* 输入栏 */
.input-bar {
  display: flex;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-card);
  border-top: 1rpx solid var(--color-border);
  align-items: center;
  gap: 16rpx;
}

.input-wrap {
  flex: 1;
  background: var(--color-bg);
  border-radius: var(--radius-full);
  padding: 4rpx 8rpx;
  border: 1rpx solid var(--color-border);
}

.input {
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}

.send-btn {
  background: #d4d4d4;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  padding: 0 32rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: var(--radius-full);
  border: none;
  min-width: 120rpx;
  transition: background 0.2s;
}

.send-btn::after { border: none; }

.send-btn.active {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  box-shadow: 0 4rpx 16rpx rgba(45, 90, 39, 0.25);
}
