.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg);
}

/* ==================== 聊天列表 ==================== */

.chat-list {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

/* ==================== 欢迎区域 ==================== */

.welcome {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 40rpx;
  text-align: center;
  animation: fadeUp 0.6s var(--ease-out);
}

.welcome-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

.welcome-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.welcome-text {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-muted);
  line-height: 1.7;
  margin-bottom: 32rpx;
  max-width: 560rpx;
}

.welcome-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
}

.wtag {
  font-size: 24rpx;
  color: var(--color-primary);
  background: var(--color-card);
  padding: 12rpx 24rpx;
  border-radius: var(--radius-full);
  border: 1rpx solid rgba(45, 90, 39, 0.12);
  transition: transform 0.2s var(--ease-bounce), background 0.15s;
}

.wtag:active {
  transform: scale(0.95);
  background: #eef5ec;
}

/* ==================== 消息行 ==================== */

.msg-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
  align-items: flex-start;
  animation: msgSlideIn 0.3s var(--ease-out);
}

@keyframes msgSlideIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.msg-row.user {
  flex-direction: row;
  justify-content: flex-end;
}

/* ==================== 头像 ==================== */

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #e8f5e6, #c8e6c3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: var(--shadow-xs);
}

.user-avatar {
  background: linear-gradient(135deg, #e3f2fd, #bbdefb);
}

.avatar-emoji {
  font-size: 28rpx;
}

/* ==================== 气泡 ==================== */

.msg-body {
  max-width: 75%;
  min-width: 0;
}

.bubble {
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-all;
  position: relative;
}

.bubble.assistant {
  background: var(--color-card);
  color: var(--color-text);
  border-bottom-left-radius: 8rpx;
  box-shadow: var(--shadow-xs);
  border: 1rpx solid var(--color-border);
}

.bubble.user {
  background: linear-gradient(135deg, #4a8c3f, #2d5a27);
  color: #fff;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(45, 90, 39, 0.2);
}

.bubble-text {
  display: block;
}

/* ==================== 参考来源 ==================== */

.refs {
  margin-top: 12rpx;
  background: var(--color-bg-warm);
  border-radius: var(--radius-md);
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--color-border);
}

.refs-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.refs-icon {
  font-size: 22rpx;
}

.refs-title {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-secondary);
}

.ref-item {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.ref-text {
  font-size: 24rpx;
  color: var(--color-primary);
  flex: 1;
}

.ref-source {
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.recommend {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: linear-gradient(135deg, #f5f0e6, #e8dfd0);
  border-radius: var(--radius-sm);
}

.recommend-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-accent);
}

.recommend-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ==================== 打字动画 ==================== */

.typing-bubble {
  display: flex;
  gap: 10rpx;
  padding: 24rpx 32rpx;
  background: var(--color-card);
  border-radius: 24rpx;
  border-bottom-left-radius: 8rpx;
  box-shadow: var(--shadow-xs);
  border: 1rpx solid var(--color-border);
}

.typing-dot {
  width: 14rpx;
  height: 14rpx;
  background: var(--color-primary);
  border-radius: 50%;
  opacity: 0.4;
  animation: typingBounce 1.4s ease-in-out infinite;
}

.typing-dot:nth-child(2) { animation-delay: 0.2s; }
.typing-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes typingBounce {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
  30% { transform: translateY(-10rpx); opacity: 1; }
}

/* ==================== 快捷问题 ==================== */

.quick-scroll {
  flex-shrink: 0;
  border-top: 1rpx solid var(--color-divider);
  background: var(--color-card);
}

.quick-questions {
  display: inline-flex;
  padding: 16rpx 24rpx;
  gap: 12rpx;
  white-space: nowrap;
}

.quick-tag {
  display: inline-block;
  font-size: 24rpx;
  color: var(--color-primary);
  background: #eef5ec;
  padding: 10rpx 24rpx;
  border-radius: var(--radius-full);
  border: 1rpx solid rgba(45, 90, 39, 0.1);
  transition: transform 0.2s var(--ease-bounce), background 0.15s;
}

.quick-tag:active {
  transform: scale(0.95);
  background: #d4e8cf;
}

/* ==================== 输入栏 ==================== */

.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-card);
  border-top: 1rpx solid var(--color-divider);
}

.input-wrap {
  flex: 1;
  background: var(--color-bg);
  border-radius: var(--radius-full);
  padding: 0 28rpx;
  height: 80rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.input-wrap:focus-within {
  border-color: rgba(45, 90, 39, 0.3);
}

.input {
  height: 80rpx;
  font-size: 28rpx;
  line-height: 80rpx;
}

.input-placeholder {
  color: var(--color-text-muted);
}

.send-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: transform 0.2s var(--ease-bounce), background 0.2s, box-shadow 0.2s;
}

.send-btn.active {
  background: linear-gradient(135deg, #4a8c3f, #2d5a27);
  box-shadow: 0 4rpx 16rpx rgba(45, 90, 39, 0.3);
}

.send-btn:active {
  transform: scale(0.9);
}

.send-icon {
  font-size: 36rpx;
  color: #fff;
  font-weight: 700;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}
