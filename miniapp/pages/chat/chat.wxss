.page { display: flex; flex-direction: column; height: 100vh; }
.chat-list { flex: 1; padding: 20rpx; box-sizing: border-box; }
.msg { margin-bottom: 20rpx; display: flex; }
.msg.user { justify-content: flex-end; }
.msg.assistant, .msg.system { justify-content: flex-start; }
.bubble {
  max-width: 80%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
}
.user .bubble { background: #2d5a27; color: #fff; }
.assistant .bubble, .system .bubble { background: #fff; color: #333; }

.refs { margin: 0 20rpx 20rpx; padding: 16rpx; background: #eef5ec; border-radius: 12rpx; font-size: 24rpx; color: #555; }
.refs-title { font-weight: 600; color: #2d5a27; display: block; margin-bottom: 8rpx; }
.ref-item { margin-top: 6rpx; }

.quick-questions { display: flex; flex-wrap: wrap; padding: 8rpx 16rpx; gap: 12rpx; }
.quick-tag {
  font-size: 24rpx;
  background: #fff;
  color: #2d5a27;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  border: 1rpx solid #c5dcc0;
}

.input-bar {
  display: flex;
  padding: 16rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  align-items: center;
}
.input { flex: 1; background: #f5f2eb; padding: 16rpx 20rpx; border-radius: 12rpx; margin-right: 16rpx; }
.send-btn { background: #2d5a27; color: #fff; font-size: 28rpx; padding: 0 28rpx; }
