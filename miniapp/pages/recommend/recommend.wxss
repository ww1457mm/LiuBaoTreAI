.page { min-height: 100vh; padding-bottom: 40rpx; }

/* 步骤指示器 */
.steps { display: flex; align-items: center; justify-content: center; padding: 32rpx 48rpx; gap: 0; }
.step-dot { width: 20rpx; height: 20rpx; border-radius: 50%; background: #e0e0e0; flex-shrink: 0; transition: all 0.3s; }
.step-dot.active { background: var(--color-primary); box-shadow: 0 0 0 6rpx rgba(45,90,39,0.15); }
.step-line { flex: 1; height: 4rpx; background: #e0e0e0; transition: background 0.3s; }
.step-line.active { background: var(--color-primary); }

/* 步骤内容 */
.step-content { padding: 0 48rpx; text-align: center; }
.step-title { display: block; font-size: 40rpx; font-weight: 700; color: var(--color-text); margin-bottom: 8rpx; }
.step-sub { display: block; font-size: 26rpx; color: var(--color-text-muted); margin-bottom: 48rpx; }

.option-grid { display: flex; flex-direction: column; gap: 20rpx; }
.opt-card { background: var(--color-card); border: 2rpx solid var(--color-border); border-radius: var(--radius-lg); padding: 32rpx; display: flex; align-items: center; gap: 20rpx; transition: all 0.15s; }
.opt-card:active { transform: scale(0.97); border-color: var(--color-primary); background: #eef5ec; }
.opt-icon { font-size: 44rpx; flex-shrink: 0; }
.opt-name { font-size: 30rpx; font-weight: 600; color: var(--color-text); }
.opt-desc { font-size: 24rpx; color: var(--color-text-muted); margin-left: auto; }

.back-link { text-align: center; font-size: 28rpx; color: var(--color-text-muted); padding: 32rpx; }

/* 加载动画 */
.loading-overlay { position: fixed; inset: 0; background: rgba(255,255,255,0.95); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24rpx; z-index: 999; }
.loading-tea { font-size: 96rpx; animation: steam 2s ease-in-out infinite; }
@keyframes steam { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-20rpx); } }
.loading-text { font-size: 30rpx; color: var(--color-text-secondary); }

/* 结果 */
.result-header { padding: 32rpx 24rpx; text-align: center; }
.result-title { display: block; font-size: 36rpx; font-weight: 700; color: var(--color-text); margin-bottom: 8rpx; }
.result-summary { display: block; font-size: 26rpx; color: var(--color-text-muted); }

.rec-card { margin: 0 24rpx 20rpx; animation: fadeUp 0.4s ease backwards; }
.rec-card:nth-child(2) { animation-delay: 0.1s; }
.rec-card:nth-child(3) { animation-delay: 0.2s; }
.rec-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.rec-name { font-size: 32rpx; font-weight: 600; color: var(--color-text); }
.rec-score { font-size: 24rpx; color: #fff; background: var(--color-primary); padding: 6rpx 16rpx; border-radius: var(--radius-full); }

.rec-meta { display: flex; gap: 16rpx; margin-bottom: 12rpx; }
.rec-type { font-size: 24rpx; color: var(--color-primary); background: #eef5ec; padding: 4rpx 14rpx; border-radius: var(--radius-full); }
.rec-price { font-size: 24rpx; color: var(--color-accent); font-weight: 500; }

.rec-reason { display: block; font-size: 26rpx; color: var(--color-text-secondary); line-height: 1.6; margin-bottom: 12rpx; }

.rec-tip { background: var(--color-bg); border-radius: var(--radius-md); padding: 12rpx 16rpx; }
.tip-label { font-size: 24rpx; color: var(--color-primary); font-weight: 500; }
.tip-text { font-size: 24rpx; color: var(--color-text-secondary); }

.restart-btn { margin: 32rpx 24rpx; }
