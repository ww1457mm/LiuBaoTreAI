/* 六堡茶 AI — 全局设计系统 */
page {
  --color-primary: #2d5a27;
  --color-primary-light: #4a8c3f;
  --color-primary-dark: #1e3d1a;
  --color-accent: #c4a574;
  --color-accent-light: #e8d5b5;
  --color-bg: #f5f0e6;
  --color-bg-warm: #faf7f2;
  --color-card: #ffffff;
  --color-text: #2c2c2c;
  --color-text-secondary: #6b6b6b;
  --color-text-muted: #a0a0a0;
  --color-border: rgba(45, 90, 39, 0.08);
  --shadow-sm: 0 4rpx 16rpx rgba(45, 90, 39, 0.06);
  --shadow-md: 0 8rpx 32rpx rgba(45, 90, 39, 0.1);
  --shadow-lg: 0 16rpx 48rpx rgba(45, 90, 39, 0.12);
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-full: 999rpx;

  background-color: var(--color-bg);
  color: var(--color-text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  line-height: 1.5;
}

/* 通用按钮 */
.btn-primary {
  background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary) 100%);
  color: #fff;
  border-radius: var(--radius-md);
  border: none;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(45, 90, 39, 0.25);
}

.btn-primary::after { border: none; }

.btn-secondary {
  background: var(--color-card);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-md);
  font-size: 30rpx;
  font-weight: 500;
}

.btn-secondary::after { border: none; }

/* 通用卡片 */
.card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--color-border);
}

/* 区块标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-primary);
  margin: 32rpx 24rpx 16rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, var(--color-accent), var(--color-primary));
  border-radius: 3rpx;
  margin-right: 12rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  color: var(--color-text-muted);
  padding: 80rpx 40rpx;
  font-size: 28rpx;
}

/* 渐变页头装饰 */
.page-header-bg {
  background: linear-gradient(160deg, var(--color-primary-dark) 0%, var(--color-primary) 50%, var(--color-primary-light) 100%);
}
