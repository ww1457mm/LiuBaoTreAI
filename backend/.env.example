# ============================================================
# 六堡茶智能服务平台 - 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# -------------------- 数据库配置 --------------------
# 开发环境：使用 SQLite（默认，无需安装额外软件）
USE_SQLITE=true
SQLITE_URL=sqlite:///./backend/liubao_tea.db

# 生产环境：使用 MySQL（取消下面注释并填入实际值）
# USE_SQLITE=false
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/liubao_tea?charset=utf8mb4

# -------------------- 硅基流动 SiliconFlow（LLM 对话生成）--------------------
# 申请地址：https://siliconflow.cn/
# 无 API Key 时系统使用本地兜底回答（功能受限）
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
# 可选模型：
# - Qwen/Qwen2.5-7B-Instruct (最便宜，推荐日常使用)
# - Qwen/Qwen2.5-14B-Instruct (能力更强)
# - Qwen/Qwen2.5-32B-Instruct (最强能力)

# 保留旧变量名兼容（可选）
DASHSCOPE_API_KEY=your_dashscope_api_key_here
QWEN_MODEL=Qwen/Qwen2.5-7B-Instruct
DASHSCOPE_BASE_URL=https://api.siliconflow.cn/v1

# -------------------- 硅基流动 SiliconFlow（向量嵌入）--------------------
# 申请地址：https://siliconflow.cn/
# 无 API Key 时使用本地伪向量（不影响 RAG 流程，但精度降低）
EMBED_MODEL=BAAI/bge-large-zh-v1.5
# 可选模型：BAAI/bge-large-zh-v1.5, BAAI/bge-small-zh-v1.5

# -------------------- 微信小程序登录 --------------------
# 在微信公众平台获取 AppID 和 AppSecret
# 登录 https://mp.weixin.qq.com -> 开发管理 -> 开发设置
WECHAT_APP_ID=
WECHAT_APP_SECRET=your_wechat_app_secret_here

# -------------------- 服务端口 --------------------
HOST=0.0.0.0
PORT=8001

# -------------------- 日志级别 --------------------
# 可选值：DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
